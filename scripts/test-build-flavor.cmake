file(WRITE "${OUTPUT_ROOT}/build-flavor-contract.cpp" "#include \"${SOURCE_ROOT}/src/build_flavor.hpp\"\nint main(){return releaseMinimal;}\n")
foreach(mode IN ITEMS missing 0 1 2)
  set(flag)
  if(NOT mode STREQUAL "missing")
    set(flag "-DXESS_RELEASE_MINIMAL=${mode}")
  endif()
  execute_process(COMMAND "${CXX}" -std=c++20 -fsyntax-only ${flag}
    "${OUTPUT_ROOT}/build-flavor-contract.cpp" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
  if(mode STREQUAL "0" OR mode STREQUAL "1")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Valid build flavor ${mode} failed: ${error}")
    endif()
  elseif(result EQUAL 0 OR NOT error MATCHES "XESS_RELEASE_MINIMAL")
    message(FATAL_ERROR "Invalid or missing build flavor ${mode} was not rejected")
  endif()
endforeach()
message(STATUS "Build flavor: explicit 0/1 accepted; missing and invalid macros rejected")
